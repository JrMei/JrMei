{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/drivediff.schema.json",
  "title": "DriveScenarioDiff Run File Schema v1",
  "type": "object",
  "required": ["run_id", "timestamp", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "meta": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenarioRecord"}
    }
  },
  "$defs": {
    "scenarioRecord": {
      "type": "object",
      "required": ["scenario_id", "passed", "metrics"],
      "additionalProperties": false,
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-zA-Z0-9_\\.\\-]+$": {"type": "number"}
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "notes": {"type": "string"}
      }
    }
  }
}
